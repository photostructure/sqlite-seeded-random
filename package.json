{
  "name": "@photostructure/sqlite-seeded-random",
  "version": "1.0.0",
  "description": "Deterministic seeded hash function for SQLite ORDER BY randomization",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "ci": "npm ci --ignore-scripts",
    "check:memory": "bash scripts/check-memory.sh",
    "clean": "rm -rf dist",
    "build": "make loadable && npm run build:js",
    "build:native": "make loadable",
    "build:js": "tsup && tsc -p tsconfig.build.json && cp dist/index.d.ts dist/index.d.mts",
    "fmt": "run-p fmt:*",
    "fmt:c": "clang-format --style=LLVM -i seeded_random.c || echo 'clang-format not available'",
    "fmt:ts": "prettier --cache --write \"**/*.{*ts,*js}\"",
    "fmt:json": "prettier --cache --write \"**/*.json\"",
    "fmt:yml": "prettier --cache --write \"**/*.{yaml,yml}\"",
    "fmt:md": "prettier --cache --write \"**/*.md\"",
    "lint": "run-s lint:*",
    "lint:tsc": "tsc --noEmit",
    "lint:eslint": "eslint",
    "update": "npm-check-updates --upgrade --install always",
    "update:actions": "pinact run -u",
    "test": "jest",
    "preflight": "npm i && run-s clean update fmt lint build test check:memory"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/photostructure/sqlite-seeded-random.git"
  },
  "keywords": [
    "sqlite",
    "random",
    "seeded",
    "deterministic",
    "hash",
    "splitmix64"
  ],
  "author": "Matthew McEachen",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/photostructure/sqlite-seeded-random/issues"
  },
  "homepage": "https://github.com/photostructure/sqlite-seeded-random#readme",
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "files": [
    "dist/index.d.mts",
    "dist/index.d.ts",
    "dist/index.js",
    "dist/index.mjs",
    "dist/darwin-arm64/seeded_random.dylib",
    "dist/darwin-x64/seeded_random.dylib",
    "dist/linux-arm64/seeded_random.so",
    "dist/linux-arm64-musl/seeded_random.so",
    "dist/linux-x64/seeded_random.so",
    "dist/linux-x64-musl/seeded_random.so",
    "dist/win32-arm64/seeded_random.dll",
    "dist/win32-x64/seeded_random.dll",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@photostructure/sqlite": "2.1.0",
    "@types/jest": "30.0.0",
    "@types/node": "26.1.1",
    "eslint": "10.8.0",
    "globals": "17.7.0",
    "jest": "30.4.2",
    "npm-check-updates": "22.2.9",
    "npm-run-all2": "9.0.2",
    "prettier": "3.9.6",
    "prettier-plugin-organize-imports": "4.3.0",
    "ts-jest": "29.4.12",
    "tsup": "8.5.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0"
  }
}
